# Cortexia staging template — never commit real values here.
# Copy into the deployment secret manager, not into the repository runtime.
APP_URL=https://staging.example.invalid
DATABASE_URL=postgresql://user:password@host/database
KIE_API_KEY=replace-in-secret-manager
KIE_WEBHOOK_HMAC_KEY=replace-in-secret-manager
FEDAPAY_SECRET_KEY=replace-in-secret-manager
FEDAPAY_WEBHOOK_SECRET=replace-in-secret-manager
VITE_FEDAPAY_PUBLIC_KEY=replace-in-deployment-config
STRIPE_SECRET_KEY=replace-in-secret-manager
STRIPE_WEBHOOK_SECRET=replace-in-secret-manager
R2_ENDPOINT=https://account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-in-secret-manager
R2_SECRET_ACCESS_KEY=replace-in-secret-manager
R2_BUCKET=cortexia-staging
