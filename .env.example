# =============================================================================
# Cortexia Environment Variables
# =============================================================================

# --- Database ---
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Neon Auth (Better Auth) ---
# Found in Neon Console → Auth → Configuration
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

# --- KIE.ai API ---
# API key for kie.ai model execution (image, video, audio, text generation)
KIE_API_KEY=your_kie_api_key_here
# Base URL for kie.ai API (default: https://api.kie.ai)
KIE_API_BASE=https://api.kie.ai

# --- Google Gemini API ---
# Used for agent LLM calls (Gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# --- FedaPay (Mobile Money) ---
# Server-side secret key for FedaPay API
FEDAPAY_SECRET_KEY=your_fedapay_secret_key_here
# Client-side public key (exposed to browser)
VITE_FEDAPAY_PUBLIC_KEY=your_fedapay_public_key_here

# --- Stripe (Card payments) ---
# Server-side secret key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Webhook signing secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# --- Cloudflare R2 (Object storage for assets) ---
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket_name

# --- App Configuration ---
# Base URL of the application (used for redirects, webhooks)
APP_URL=https://cortexia.originafrika.online

# --- Resend (Email) ---
# API key for sending magic link emails
RESEND_API_KEY=re_your_resend_api_key_here

# --- Sentry (Error Monitoring) ---
# DSN for Sentry error tracking
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# --- Plausible (Analytics) ---
# Plausible analytics domain (configured in script tag, not env var)
# Set data-domain in __root.tsx script tag

# --- Capability readiness ---
# Client-visible values: ready, beta, or disabled. Defaults are disabled for unfinished capabilities.
VITE_CAPABILITY_WORKFLOWS=disabled
VITE_CAPABILITY_CANVAS=disabled
VITE_CAPABILITY_DEVELOPERS=disabled
VITE_CAPABILITY_AGENT=disabled
VITE_CAPABILITY_TEXT=disabled
VITE_CAPABILITY_AUDIO=disabled
VITE_CAPABILITY_MUSIC=disabled
# Server-side overrides used by API/server functions. Keep in sync with the client values.
CAPABILITY_WORKFLOWS=disabled
CAPABILITY_CANVAS=disabled
CAPABILITY_DEVELOPERS=disabled
CAPABILITY_AGENT=disabled
CAPABILITY_TEXT=disabled
CAPABILITY_AUDIO=disabled
CAPABILITY_MUSIC=disabled
